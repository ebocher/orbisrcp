<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>

	<!--
		The build follows the DBeaver build: same parent, same Tycho version, same Java version and
		same p2 repositories (Eclipse release + DBeaver third-party bundles).

		Expected layout (the same as for the DBeaver repositories, see dbeaver/AGENTS.md):
		    <dev-home>/dbeaver-common
		    <dev-home>/datadam-api
		    <dev-home>/dbeaver
		    <dev-home>/orbisrcp
		DBeaver must first be installed in the local Maven repository (mvn install) so that Tycho can
		resolve the org.jkiss.dbeaver.* bundles from it. See README.md.
	-->
	<parent>
		<groupId>com.dbeaver.common</groupId>
		<artifactId>com.dbeaver.common.main</artifactId>
		<version>2.9.0-SNAPSHOT</version>
		<relativePath>../dbeaver-common/pom.xml</relativePath>
	</parent>

	<groupId>org.orbisgis.rcp</groupId>
	<artifactId>orbisrcp</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<modules>
		<module>plugins</module>
		<module>features</module>
		<module>p2</module>
	</modules>

	<properties>
		<!-- DBeaver ignores local artifacts because it builds everything in a single reactor.
		     We need them: the DBeaver bundles come from the local Maven repository. -->
		<tycho.localArtifacts>include</tycho.localArtifacts>

		<!-- Libraries embedded in the Groovy editor bundle -->
		<groovy.version>4.0.29</groovy.version>
		<ivy.version>2.5.3</ivy.version>
	</properties>

	<build>
		<sourceDirectory>${project.basedir}/src</sourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<environments>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>aarch64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>aarch64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-packaging-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Built-By>org.orbisgis</Built-By>
						</manifestEntries>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Build against a released DBeaver instead of a local build of the DBeaver master:
			    mvn clean verify -Pdbeaver-release
			The update site can be changed with -Ddbeaver.update.url=...
		-->
		<profile>
			<id>dbeaver-release</id>
			<properties>
				<dbeaver.update.url>https://dbeaver.io/update/latest/</dbeaver.update.url>
			</properties>
			<repositories>
				<repository>
					<id>dbeaver-update-site</id>
					<url>${dbeaver.update.url}</url>
					<layout>p2</layout>
				</repository>
			</repositories>
		</profile>
	</profiles>
</project>
