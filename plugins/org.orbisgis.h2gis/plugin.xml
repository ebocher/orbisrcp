<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">

        <!-- H2GIS driver following the development version (snapshots) of H2GIS. DBeaver has an official
             H2GIS driver (plugin org.jkiss.dbeaver.ext.h2) following the releases.

             The version must be an explicit x.y.z-SNAPSHOT: Maven Central does not have it, so DBeaver looks in
             the snapshots repository and takes its last build. RELEASE, LATEST or a version pattern are always
             resolved by Maven Central, with a release. Change it to the version of the H2GIS pom.xml when the
             development of a new version starts. -->
        <datasource
                class="org.orbisgis.h2gis.H2GISSnapshotDataSourceProvider"
                description="%datasource.h2gis.description"
                id="h2gis_snapshot"
                parent="generic"
                label="H2GIS Snapshot"
                icon="icons/h2gis_icon.png"
                dialect="h2">
            <drivers managable="true">

                <driver
                        id="h2gis_embedded_snapshot"
                        label="H2GIS Embedded Snapshot"
                        icon="icons/h2gis_icon.png"
                        iconBig="icons/h2gis_icon_big.png"
                        category="H2"
                        class="org.h2.Driver"
                        sampleURL="jdbc:h2:{file}"
                        webURL="http://www.h2gis.org/"
                        embedded="true"
                        description="H2GIS embedded, development version (2.2.6-SNAPSHOT)"
                        categories="spatial,sql,embedded">

                    <file type="jar" path="maven:/org.orbisgis:h2gis:2.2.6-SNAPSHOT"/>
                    <file type="jar" path="maven:/org.orbisgis:h2gis-api:2.2.6-SNAPSHOT"/>
                    <file type="jar" path="maven:/org.orbisgis:h2gis-utilities:2.2.6-SNAPSHOT"/>

                    <parameter name="query-get-active-db" value="SELECT SCHEMA()"/>
                    <parameter name="query-set-active-db" value="SET SCHEMA = ?"/>
                    <parameter name="query-shutdown" value="shutdown"/>
                    <parameter name="omit-catalog" value="true"/>
                </driver>

                <driver
                        id="h2gis_server_snapshot"
                        label="H2GIS Server Snapshot"
                        icon="icons/h2gis_icon.png"
                        iconBig="icons/h2gis_icon_big.png"
                        category="H2"
                        class="org.h2.Driver"
                        sampleURL="jdbc:h2:tcp://{host}[:{port}]/{database}"
                        defaultPort="9092"
                        webURL="http://www.h2gis.org/"
                        description="H2GIS server, development version (2.2.6-SNAPSHOT)"
                        categories="spatial,sql,server">

                    <file type="jar" path="maven:/org.orbisgis:h2gis:2.2.6-SNAPSHOT"/>
                    <file type="jar" path="maven:/org.orbisgis:h2gis-api:2.2.6-SNAPSHOT"/>
                    <file type="jar" path="maven:/org.orbisgis:h2gis-utilities:2.2.6-SNAPSHOT"/>

                    <parameter name="query-get-active-db" value="SELECT SCHEMA()"/>
                    <parameter name="query-set-active-db" value="SET SCHEMA = ?"/>
                    <parameter name="query-shutdown" value="shutdown"/>
                    <parameter name="omit-catalog" value="true"/>
                </driver>

            </drivers>

        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.dataTypeProvider">
        <provider
                class="org.orbisgis.h2gis.data.H2GISSnapshotValueHandlerProvider"
                description="H2GIS Snapshot data types provider"
                id="org.orbisgis.h2gis.data.H2GISSnapshotValueHandlerProvider"
                label="H2GIS Snapshot data types provider">

            <datasource id="h2gis_snapshot"/>

            <type name="*"/>

        </provider>
    </extension>

    <extension point="org.jkiss.dbeaver.mavenRepository">
        <repository id="central-portal-snapshots" snapshot="true" name="Maven Central snapshots" url="https://central.sonatype.com/repository/maven-snapshots/" order="100"/>
    </extension>

</plugin>
